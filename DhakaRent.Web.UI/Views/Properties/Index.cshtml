@model DhakaRent.Web.UI.ViewModels.PublicPropertySearchViewModel

@{
    ViewData["Title"] = "Available Properties";
    var filters = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.Area)) filters.Add(Model.Area);
    if (Model.PropertyType.HasValue) filters.Add(Model.PropertyType.Value.ToString());
    if (Model.Bedrooms.HasValue) filters.Add($"{Model.Bedrooms} bedrooms");
    if (Model.MinRent.HasValue) filters.Add($"From ৳{Model.MinRent:N0}");
    if (Model.MaxRent.HasValue) filters.Add($"Up to ৳{Model.MaxRent:N0}");
    var isTenant = User.IsInRole("Tenant");
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="container py-4">

    <div class="mb-4">
        <h1>Browse properties</h1>
        <p class="text-muted">
            <img src="~/icons/shield-check.svg" width="18" height="18" alt="" /> Listings are reviewed before they appear here.
        </p>
    </div>

    @foreach (var (key, style) in new[] { ("SuccessMessage", "success"), ("InfoMessage", "info"), ("ErrorMessage", "danger") })
    {
        if (TempData[key] is string message)
        {
            <div class="alert alert-@style" role="status">@message</div>
        }
    }

    @if (filters.Count > 0 && ViewData.ModelState.IsValid)
    {
        <div class="d-flex align-items-center flex-wrap gap-2" aria-label="Active filters">
            @foreach (var filter in filters) { <span class="listing-type">@filter</span> }
            <button type="button" class="btn btn-sm btn-outline-secondary" data-open-search>Edit filters</button>
        </div>
    }
    @if (Model.Properties.Any(p => p.Latitude.HasValue && p.Longitude.HasValue))
    {
        <details class="mb-3" data-results-map><summary>View rentals on a map</summary>
            <div class="listing-map" aria-label="Rental locations"></div>
            <ul class="visually-hidden">
            @foreach (var listing in Model.Properties.Where(p => p.Latitude.HasValue && p.Longitude.HasValue))
            {
                <li><a asp-action="Details" asp-route-id="@listing.Id" data-lat="@listing.Latitude!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-lon="@listing.Longitude!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)">@listing.Title</a></li>
            }
            </ul>
        </details>
    }
    <div class="result-heading">
        <h2 class="h4">Available rentals</h2>
        <span class="text-muted">@Model.Properties.Count @(Model.Properties.Count == 1 ? "listing" : "listings")</span>
        @if (isTenant)
        {
            <a asp-controller="SavedProperty" asp-action="Index" class="ms-auto">My wishlist</a>
        }
    </div>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-warning">Please correct your search filters. <button type="button" class="btn btn-link" data-open-search>Edit filters</button></div>
    }
    else if (!Model.Properties.Any())
    {
        <div class="alert alert-info">No rentals match these filters. Try a different area or a wider budget.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model.Properties)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="card listing-card h-100">
                        <div class="card-body">
                            @if (item.CoverId.HasValue)
                            {
                                <img class="listing-asset" src="@Url.Action("Show","ListingMedia",new { id = item.CoverId })" alt="@item.Title" loading="lazy" />
                            }
                            <span class="listing-type">@item.PropertyType</span>
                            <h3 class="card-title h4">@item.Title</h3>
                            <p class="text-muted mb-0">@item.Address · @item.Area, Dhaka</p>
                            <p class="listing-specs">@item.Bedrooms bed · @item.Bathrooms bath · @item.SizeInSqFt.ToString("N0") sqft<br />
                                @(item.IsFurnished ? "Furnished" : "Unfurnished")
                            </p>
                            <p class="listing-rent">৳@item.MonthlyRent.ToString("N0") <small>/ month</small></p>
                            <a asp-controller="Properties" asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-outline-primary" aria-label="View details for @item.Title">View details</a>
                            @if (isTenant)
                            {
                                <a asp-controller="PropertyInquiry" asp-action="Create" asp-route-propertyId="@item.Id" class="btn btn-primary">Contact owner</a>
                                <form asp-controller="SavedProperty" asp-action="@(item.IsSavedToWishlist ? "Remove" : "Save")" method="post"
                                      onsubmit="@(item.IsSavedToWishlist ? "return confirm('Remove this property from your wishlist?')" : null)">
                                    <input type="hidden" name="propertyId" value="@item.Id" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button class="btn btn-outline-secondary w-100">@(item.IsSavedToWishlist ? "Remove from wishlist" : "Save to wishlist")</button>
                                </form>
                            }
                            else if (User.Identity?.IsAuthenticated != true)
                            {
                                <partial name="_GuestPropertyActions" model="item.Id" />
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>
