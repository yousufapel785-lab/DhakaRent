@model DhakaRent.Web.UI.ViewModels.PublicPropertyDetailsViewModel

@{
    ViewData["Title"] = "Property Details";

    var description = string.IsNullOrWhiteSpace(Model.Description)
        ? "No description provided."
        : Model.Description;

    // Property ID from ViewModel.
    int propertyId = Model.Id;

    // Wishlist actions are available to Tenants only.
    bool isTenant =
        User.Identity?.IsAuthenticated == true &&
        User.IsInRole("Tenant");

    // Saved state prepared by PropertiesController.
    bool isSavedToWishlist =
        isTenant && Model.IsSavedToWishlist;
}

<div class="container py-4">

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- Info Message -->
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show"
             role="alert">

            @TempData["InfoMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- Property Details Card -->
    <div class="card shadow-sm property-details-card">

        <div class="card-body p-4">

            <span class="listing-type">@Model.PropertyType</span>
            <h1 class="mt-3 mb-2">@Model.Title</h1>

            <p class="property-location mb-3">@Model.Area, Dhaka</p>

            <!-- Monthly Rent -->
            <h3 class="property-rent mb-4">

                ৳@Model.MonthlyRent.ToString("N0")

                <small class="text-muted fs-6">
                    / month
                </small>

            </h3>

            @if (User.Identity?.IsAuthenticated != true)
            {
                <partial name="_GuestPropertyActions" model="propertyId" />
            }
            <!-- Tenant Actions -->
            @if (isTenant && propertyId > 0)
            {
                <div class="property-action-panel">

                    <!-- Wishlist Saved State -->
                    @if (isSavedToWishlist)
                    {
                        <!-- Saved Indicator -->
                        <span class="wishlist-saved-indicator">

                            <i class="bi bi-heart-fill text-danger"></i>

                            Saved to Wishlist

                        </span>

                        <!-- Remove from Wishlist Form -->
                        <form asp-controller="SavedProperty"
                              asp-action="Remove"
                              method="post"
                              onsubmit="return confirm('Remove this property from your wishlist?');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="propertyId"
                                   value="@propertyId" />

                            <!-- Return to same Property Details page -->
                            <input type="hidden"
                                   name="returnToDetails"
                                   value="true" />

                            <button type="submit"
                                    class="btn btn-outline-danger">

                                <i class="bi bi-heart-fill"></i>

                                Remove from Wishlist

                            </button>

                        </form>
                    }
                    else
                    {
                        <!-- Save to Wishlist Form -->
                        <form asp-controller="SavedProperty"
                              asp-action="Save"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="propertyId"
                                   value="@propertyId" />

                            <!-- Return to same Property Details page -->
                            <input type="hidden"
                                   name="returnToDetails"
                                   value="true" />

                            <button type="submit"
                                    class="btn btn-outline-primary">

                                <i class="bi bi-heart"></i>

                                Save to Wishlist

                            </button>

                        </form>
                    }

                    <!-- Contact Owner -->
                    <a asp-controller="PropertyInquiry"
                       asp-action="Create"
                       asp-route-propertyId="@propertyId"
                       class="btn btn-primary">

                        <i class="bi bi-chat-dots me-1"></i>

                        Contact Owner

                    </a>

                    <!-- Request Viewing -->
                    <a asp-controller="ViewingRequest"
                       asp-action="Create"
                       asp-route-propertyId="@propertyId"
                       class="btn btn-outline-primary">

                        <i class="bi bi-calendar-check me-1"></i>

                        Request Viewing

                    </a>

                </div>
            }

            <hr />

            <!-- Property Information -->
            <h5 class="fw-bold mb-3">

                <i class="bi bi-house-door me-1"></i>

                Property Information

            </h5>

            <dl class="property-facts">
                <div>
                    <dt>Property Type</dt>
                    <dd>@Model.PropertyType</dd>
                </div>
                <div>
                    <dt>Size</dt>
                    <dd>@Model.SizeInSqFt.ToString("N0") sqft</dd>
                </div>
                <div>
                    <dt>Bedrooms</dt>
                    <dd>@Model.Bedrooms</dd>
                </div>
                <div>
                    <dt>Bathrooms</dt>
                    <dd>@Model.Bathrooms</dd>
                </div>
                <div>
                    <dt>Furnishing</dt>
                    <dd>@(Model.IsFurnished
                        ? "Furnished"
                        : "Unfurnished")</dd>
                </div>
                <div>
                    <dt>Available From</dt>
                    <dd>@(Model.AvailableFrom?.ToString("dd MMM yyyy")
                        ?? "Not specified")</dd>
                </div>
            </dl>

            <hr />

            <!-- Property Address -->
            <h5 class="fw-bold mb-3">

                <i class="bi bi-geo-alt me-1"></i>

                Address

            </h5>

            <p class="text-muted text-break">
                @Model.Address
            </p>

            <hr />

            <!-- Property Description -->
            <h5 class="fw-bold mb-3">

                <i class="bi bi-card-text me-1"></i>

                Description

            </h5>

            <p class="property-description mb-0">@description</p>

        </div>

    </div>

</div>
