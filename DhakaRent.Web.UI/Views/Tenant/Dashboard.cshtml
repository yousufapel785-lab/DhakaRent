@{
    ViewData["Title"] = "Tenant dashboard";
}
<partial name="_SuccessMessage" />

<section class="py-4">
    <h1>Tenant dashboard</h1>
    <div class="card mt-4"><div class="card-body">
        <h2>Find a rental</h2>
        <p class="text-muted">Search reviewed listings by neighborhood, budget, and property type.</p>
        <a class="btn btn-primary" asp-controller="Properties" asp-action="Index">Browse properties</a>
    </div></div>
    <nav class="mt-4" aria-label="Tenant activity">
        <h2>My activity</h2>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-primary" asp-controller="SavedProperty" asp-action="Index">My wishlist</a>
            <a class="btn btn-outline-primary" asp-controller="PropertyInquiry" asp-action="Index">My inquiries</a>
            <a class="btn btn-outline-primary" asp-controller="ViewingRequest" asp-action="Index">My viewing requests</a>
            <a class="btn btn-outline-primary" asp-controller="Messaging" asp-action="Index">My conversations</a>
        </div>
    </nav>
</section>
