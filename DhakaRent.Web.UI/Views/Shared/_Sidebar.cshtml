@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject DhakaRent.DataAccess.Context.ApplicationDbContext NavigationDb
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var workspace = new List<(string Name, string Controller, string Action, string Icon)>();
    if (User.IsInRole("Admin") || User.IsInRole("PropertyOwner"))
        workspace.Add(("Subscription", "Subscriptions", "Index", "clipboard-list"));
    if (User.IsInRole("Admin"))
    {
        workspace.Add(("Dashboard", "Admin", "Dashboard", "layout-dashboard"));
        workspace.Add(("Listing reports", "ListingReports", "Index", "clipboard-list"));
        workspace.Add(("Review queue", "Admin", "PendingProperties", "clipboard-list"));
    }
    if (User.IsInRole("PropertyOwner"))
    {
        workspace.Add(("My listings", "PropertyOwner", "Dashboard", "house"));
        workspace.Add(("My buildings", "Building", "Index", "building-2"));
        workspace.Add(("Portfolio", "Portfolio", "Index", "building-2"));
        workspace.Add(("Received inquiries", "OwnerInquiry", "Index", "message-circle"));
        workspace.Add(("Viewing requests", "OwnerViewingRequest", "Index", "calendar-days"));
    }
    if (User.IsInRole("Tenant"))
    {
        workspace.Add(("My dashboard", "Tenant", "Dashboard", "layout-dashboard"));
        workspace.Add(("My wishlist", "SavedProperty", "Index", "heart"));
        workspace.Add(("My inquiries", "PropertyInquiry", "Index", "message-circle"));
        workspace.Add(("My viewing requests", "ViewingRequest", "Index", "calendar-days"));
    }
    if (User.IsInRole("Tenant") || User.IsInRole("PropertyOwner"))
        workspace.Add(("My conversations", "Messaging", "Index", "messages-square"));
    if (User.IsInRole("Tenant") || User.IsInRole("PropertyOwner"))
        workspace.Add(("Leases and billing", "RentalDesk", "Index", "clipboard-list"));
    if (User.Identity?.IsAuthenticated == true)
        workspace.Add(("Private documents", "Documents", "Index", "clipboard-list"));
    if (User.Identity?.IsAuthenticated == true)
    {
        var actor = User.FindFirstValue(ClaimTypes.NameIdentifier);
        var permissions = await NavigationDb.BuildingStaff.AsNoTracking()
            .Where(a => a.StaffUserId == actor && !a.Building.IsArchived && (a.CanManageRepairs || a.CanReadAccounts))
            .Select(a => new { a.CanManageRepairs, a.CanReadAccounts }).Distinct().ToListAsync();
        if (permissions.Any(a => a.CanManageRepairs))
            workspace.Add(("Assigned repairs", "AssignedRepairs", "Index", "clipboard-list"));
        if (User.IsInRole("PropertyOwner") || permissions.Any(a => a.CanReadAccounts))
            workspace.Add(("Building accounts", "BuildingAccounts", "Index", "clipboard-list"));
    }
}
<aside class="offcanvas-lg offcanvas-start shell-sidebar" tabindex="-1" id="site-menu" aria-labelledby="menu-title">
    <div class="offcanvas-header"><h2 class="h5 mb-0" id="menu-title">Menu</h2>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#site-menu" aria-label="Close menu"></button>
    </div>
    <nav class="sidebar-links" aria-label="Main menu">
        <h2>Explore</h2>
        <a asp-controller="Home" asp-action="Index" aria-current="@(controller == "Home" && action == "Index" ? "page" : null)"><img src="~/icons/house.svg" alt="" />Home</a>
        <a asp-controller="Properties" asp-action="Index" aria-current="@(controller == "Properties" ? "location" : null)"><img src="~/icons/building-2.svg" alt="" />Browse properties</a>
        @if (workspace.Count > 0)
        {
            <h2>My workspace</h2>
            @foreach (var link in workspace)
            {
                var current = link.Controller == "Admin" ? controller == "Admin" && (link.Action == "Dashboard") == (action == "Dashboard")
                    : link.Controller == "Building" ? controller is "Building" or "Floor" or "RentalUnit" : controller == link.Controller;
                <a asp-controller="@link.Controller" asp-action="@link.Action" aria-current="@(current ? "location" : null)">
                    <img src="@Url.Content($"~/icons/{link.Icon}.svg")" alt="" />@link.Name
                </a>
            }
        }
        <h2>Neighborhoods</h2>
        @foreach (var area in new[] { "Mirpur", "Dhanmondi", "Uttara", "Gulshan" })
        {
            <a href="@Url.Action("Index", "Properties")?Area=@area"><img src="~/icons/map-pin.svg" alt="" />@area</a>
        }
    </nav>
</aside>
