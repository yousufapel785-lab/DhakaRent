@using DhakaRent.Entities.Enums
@{
    ViewData["Title"] = "Find a rental";
    var categories = new[]
    {
        (PropertyType.Apartment, "Apartments", "building-2", "sage"),
        (PropertyType.House, "Houses", "house", "clay"),
        (PropertyType.Studio, "Studios", "panels-top-left", "blue"),
        (PropertyType.Duplex, "Duplexes", "layers-2", "gold"),
        (PropertyType.Room, "Rooms", "bed-single", "lavender"),
        (PropertyType.Shop, "Shops", "store", "aqua")
    };
}
<partial name="_SuccessMessage" />

<section class="rental-hero" aria-labelledby="hero-title">
    <div class="hero-copy">
        <span class="place-label"><img src="~/icons/map-pin.svg" alt="" /> Dhaka, Bangladesh</span>
        <h1 id="hero-title">Find a home<br />in <em>Dhaka.</em></h1>
        <p>Explore reviewed rental listings across the city, from a room of your own to a home for the whole family.</p>
        <a class="hero-link" asp-controller="Properties" asp-action="Index">Browse all properties <img src="~/icons/arrow-right.svg" alt="" /></a>
    </div>
    <div class="hero-art"><img src="~/images/dhaka-neighborhood.webp" alt="Illustration of leafy Dhaka apartment buildings with sunlit balconies" width="1180" height="787" fetchpriority="high" /></div>
</section>
<section aria-labelledby="category-heading" class="categories">
    <h2 id="category-heading">Browse by property type</h2>
    <div class="type-grid">
        @foreach (var (type, label, icon, color) in categories)
        {
            <a class="type-card @color" asp-controller="Properties" asp-action="Index" asp-route-PropertyType="@type">
                <span class="type-icon"><img src="@Url.Content($"~/icons/{icon}.svg")" alt="" /></span>
                <span>@label</span><img class="type-arrow" src="~/icons/arrow-up-right.svg" alt="" />
            </a>
        }
    </div>
</section>
