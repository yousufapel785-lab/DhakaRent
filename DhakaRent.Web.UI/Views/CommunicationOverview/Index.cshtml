@using DhakaRent.Web.UI.ViewModels
@model ContactOverview
@{ ViewData["Title"] = "Listing contacts"; }
<h1>Listing contacts</h1>
<nav class="d-flex flex-wrap gap-2 my-3" aria-label="Contact type">
    @foreach (var kind in Enum.GetValues<ContactKind>())
    {
        <a asp-action="Index" asp-route-kind="@kind" aria-current="@(kind == Model.Kind ? "page" : null)"
           class="btn @(kind == Model.Kind ? "btn-primary" : "btn-outline-primary")">@(kind == ContactKind.Viewings ? "Viewing requests" : kind.ToString())</a>
    }
</nav>
@if (Model.Rows.Count == 0) { <p>No records on this page.</p> }
@foreach (var row in Model.Rows)
{
    <article class="card card-body mb-3">
        <h2 class="h5"><a asp-controller="Admin" asp-action="ReviewProperty" asp-route-id="@row.PropertyId">@row.Title</a></h2>
        <p class="text-muted">Record #@row.Id · @row.ActivityUtc.AddHours(6).ToString("dd MMM yyyy, HH:mm") (Dhaka)</p>
        <div class="d-flex gap-4 flex-wrap"><partial name="_ContactPerson" model="row.Tenant" /><partial name="_ContactPerson" model="row.Owner" /></div>
    </article>
}
<nav aria-label="Pages" class="d-flex gap-3">
    @if (Model.Page > 1) { <a asp-route-kind="@Model.Kind" asp-route-page="@(Model.Page - 1)">Previous</a> }
    @if (Model.HasNext) { <a asp-route-kind="@Model.Kind" asp-route-page="@(Model.Page + 1)">Next</a> }
</nav>
